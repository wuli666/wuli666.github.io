---
import type { CollectionEntry } from 'astro:content';

const { posts } = Astro.props as { posts: CollectionEntry<'blog'>[] };
const day = (d: Date) => d.toISOString().slice(0, 10);
---

{posts.length === 0 ? (
  <p class="empty">Nothing published yet. Add a Markdown file to src/content/blog/ to write the first post.</p>
) : (
  <ul>
    {posts.map((p, k) => (
      <li data-reveal style={`--k:${k}`}>
        <time datetime={p.data.date.toISOString()}>{day(p.data.date)}</time>
        <a href={`/blog/${p.id}/`}>
          <span class="mark" data-layer={p.data.layer} aria-hidden="true" />
          <span>{p.data.title}</span>
          {p.data.draft && <em>draft</em>}
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  ul { list-style: none; margin: 0; padding: 0; }
  li {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0 1.5rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
  }
  time { color: var(--muted); font-variant-numeric: tabular-nums; }
  a { display: flex; align-items: baseline; gap: 0.75rem; text-decoration: none; }
  a span:last-of-type { display: inline-block; transition: transform 0.25s; }
  a:hover span:last-of-type { text-decoration: underline; transform: translateX(0.35rem); }
  .mark { position: relative; top: -0.1em; transition: transform 0.4s cubic-bezier(0.2, 0.9, 0.25, 1.2); }
  a:hover .mark { transform: rotate(225deg) scale(1.3); }
  em { font-style: normal; font-size: 0.8em; color: var(--muted); }
  .empty { color: var(--muted); }
  @media (max-width: 520px) {
    li { grid-template-columns: 1fr; }
    time { font-size: 0.85rem; }
  }
</style>
